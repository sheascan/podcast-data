      <tr>
       <!----><td dir="ltr" width="100">
        <a  href="http://click.comms.irishtimes.com/?qs=ABp7ImQiOjUwMzEsInQiOjY4MjQsInMiOjUxfQAzAAAAAAETxlagm8dekx3iHRCovyqZLvbt0BcPXr2qaDPdV1w2QMiDbOViKsxxc9gOTpqE9BqEJr30S9fumWDox9bFYiALShIsrCgTVMHWqKI1CyjHAA" style="font-weight:400;text-decoration:none;" target="_blank"><img src="https://author-service-images-prod-us-east-1.publishing.aws.arc.pub/irishtimes/HOZIXYH4FZEQZB4UFV5RLJQOFY.png" style="max-width:80px;border-radius:50%;" width="80"></a></td><!----><td dir="ltr" style="font-size:14px;line-height:1.5;font-weight:200;">
